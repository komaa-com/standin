# What every editor should agree on, so a diff is a change and not a reformat.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,mdx}]
# Two trailing spaces is a hard line break in Markdown. Trimming them silently
# rewrites the author's paragraph.
trim_trailing_whitespace = false

[makefile]
# Tabs are not a style choice here. Make requires them.
indent_style = tab
