# Your StandIn connection secret, from https://standin.komaa.com
STANDIN_SECRET=

# Deepgram
DEEPGRAM_API_KEY=

# Optional: the models the session is built with
# DEEPGRAM_LISTEN_MODEL=nova-3
# DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
# DEEPGRAM_THINK_PROVIDER=open_ai
# DEEPGRAM_THINK_MODEL=gpt-4o-mini
# DEEPGRAM_LANGUAGE=en
# DEEPGRAM_GREETING=Hello, how can I help?
# DEEPGRAM_INSTRUCTIONS=

# Optional: reason with your own model instead
# DEEPGRAM_THINK_ENDPOINT_URL=
# DEEPGRAM_THINK_ENDPOINT_HEADERS={"authorization":"Bearer ..."}

# Optional: what the agent sees when it uses the look tool
# STANDIN_VISION_API_URL=https://api.openai.com/v1/chat/completions
# STANDIN_VISION_MODEL=gpt-4o-mini
# STANDIN_VISION_API_KEY=

# STANDIN_PORT=9442
