# From the StandIn portal. Arms the plugin; without it this worker takes
# no Teams calls and behaves as if the plugin were not installed.
STANDIN_SECRET=

# Where the call listener binds. Expose this port and register the public
# wss:// URL as your identity's agent voice URL.
STANDIN_PORT=9442
STANDIN_HOST=0.0.0.0
STANDIN_WS_PATH=/msteams/calling

# Your LiveKit project. The plugin creates one room per Teams call and
# dispatches your agent into it.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Whatever your agent uses.
OPENAI_API_KEY=
