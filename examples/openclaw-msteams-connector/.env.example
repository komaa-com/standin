# The plugin reads its settings from openclaw.json, not from the environment -
# it runs inside the gateway, and OpenClaw owns its config. These two are here
# because they are what you would rather not paste into a file.
#
# Reference them from openclaw.json as {"$env": "STANDIN_SECRET"} wherever your
# gateway's secret-reference syntax allows it, or paste the values directly.

# From the StandIn portal. Every socket StandIn dials is signed with it.
STANDIN_SECRET=

# Whichever realtime speech-to-speech provider your gateway is configured with.
OPENAI_API_KEY=
