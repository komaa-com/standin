# Your StandIn connection secret, from https://standin.komaa.com
STANDIN_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional
# ELEVENLABS_FIRST_MESSAGE=Hello, how can I help?
# ELEVENLABS_ENVIRONMENT=
# ELEVENLABS_AGENT_BRANCH_ID=
# ELEVENLABS_LOG_TRANSCRIPTS=true

# Where this worker listens. The defaults match the documented tunnel command.
# STANDIN_PORT=9442
# STANDIN_HOST=0.0.0.0
# STANDIN_WS_PATH=/msteams/calling
