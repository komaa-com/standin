# Copy to .env and fill in. Everything here has a home:
# STANDIN_* belongs to the SDK's listener, the rest to the realtime provider.

# ---- StandIn -----------------------------------------------------------------
# The connection secret from the StandIn portal. Without it, StandIn's dial
# cannot be authenticated and no call is answered.
STANDIN_SECRET=

# Where the listener binds. Defaults shown; you rarely change them. Use
# 127.0.0.1 when only a local tunnel should reach it - the upgrade is
# HMAC-authenticated either way.
# STANDIN_HOST=0.0.0.0
# STANDIN_PORT=9442
# STANDIN_WS_PATH=/msteams/calling

# ---- the realtime model ------------------------------------------------------
# The conversation runs on this. Hermes is reached through it, not instead of it.
OPENAI_API_KEY=

# Azure OpenAI instead:
# MSTEAMS_BRIDGE_REALTIME_BACKEND=azure
# MSTEAMS_BRIDGE_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# MSTEAMS_BRIDGE_AZURE_DEPLOYMENT=<your realtime deployment>
# AZURE_OPENAI_API_KEY=

# ---- plugin policy -----------------------------------------------------------
# Every one of these has a config.yaml key, which is the better place for them.
# They exist so a container can be configured without a file.
# MSTEAMS_BRIDGE_ALLOWLIST=00000000-0000-0000-0000-000000000000
# MSTEAMS_BRIDGE_ALLOW_ALL=false
# MSTEAMS_BRIDGE_SESSION_SCOPE=per-aad
# MSTEAMS_BRIDGE_REQUIRE_RECORDING=true
# MSTEAMS_BRIDGE_WAKE_PHRASES=assistant,hermes
# MSTEAMS_BRIDGE_LANGUAGES=en,ar
