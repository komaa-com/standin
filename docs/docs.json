  "redirects": [
    {
      "source": "/teams-app",
      "destination": "/teams/azure-bot"
    },
    {
      "source": "/openclaw/:slug*",
      "destination": "/typescript-sdk/plugins/openclaw"
    },
    {
      "source": "/hermes/:slug*",
      "destination": "/python-sdk/plugins/hermes-agent"
    },
    {
      "source": "/livekit/:slug*",
      "destination": "/python-sdk/plugins/livekit"
    },
    {
      "source": "/elevenlabs/:slug*",
      "destination": "/python-sdk/plugins/elevenlabs"
    }
