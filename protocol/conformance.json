  "chat": {
    "$comment": [
      "The Microsoft Teams messages lane. Python chat.py and TypeScript chat.ts must parse",
      "and build byte-identical wire payloads: buildReply's tenantId/conversationId",
      "echo is the cross-tenant leak guard the whole relay rests on, so a divergence",
      "here is a security bug, not a cosmetic one."
    ],
    "schemaVersion": 1,
    "parseInbound": {
      "accepts": [
        {
          "name": "full message",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"scope\": \"personal\", \"text\": \"hello\", \"sender\": {\"displayName\": \"Alaa\", \"aadObjectId\": \"aad-1\", \"isGuest\": false, \"isLinkedOwner\": true}, \"attachments\": [{\"contentType\": \"image/png\"}], \"mentions\": [\"bot\"], \"locale\": \"en-GB\"}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "hello",
            "senderName": "Alaa",
            "senderAadId": "aad-1",
            "senderIsGuest": false,
            "senderIsLinkedOwner": true,
            "attachments": [
              {
                "contentType": "image/png"
              }
            ],
            "mentions": [
              "bot"
            ],
            "locale": "en-GB",
            "cardAction": null,
            "isPersonal": true
          }
        },
        {
          "name": "minimal message defaults to personal scope",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\"}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": true
          }
        },
        {
          "name": "unknown scope is an OPEN enum, relayed not rejected",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"scope\": \"channel-of-the-future\"}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "channel-of-the-future",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": false
          }
        },
        {
          "name": "non-string text reads as empty",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"text\": 42}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": true
          }
        },
        {
          "name": "non-list attachments and mentions are ignored",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"attachments\": \"nope\", \"mentions\": 7}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": true
          }
        },
        {
          "name": "card action with empty text",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"text\": \"\", \"cardAction\": {\"verb\": \"approve\"}}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": {
              "verb": "approve"
            },
            "isPersonal": true
          }
        },
        {
          "name": "equal schemaVersion is accepted",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"schemaVersion\": 1}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": true
          }
        },
        {
          "name": "non-object sender is tolerated",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"sender\": \"nope\"}",
          "expected": {
            "tenantId": "t-1",
            "conversationId": "c-1",
            "activityId": "a-1",
            "scope": "personal",
            "text": "",
            "senderName": null,
            "senderAadId": null,
            "senderIsGuest": false,
            "senderIsLinkedOwner": false,
            "attachments": [],
            "mentions": [],
            "locale": null,
            "cardAction": null,
            "isPersonal": true
          }
        }
      ],
      "rejects": [
        {
          "name": "malformed json",
          "body": "{not json"
        },
        {
          "name": "body is an array",
          "body": "[1,2,3]"
        },
        {
          "name": "body is a string",
          "body": "\"hello\""
        },
        {
          "name": "missing tenantId",
          "body": "{\"conversationId\": \"c\", \"activityId\": \"a\"}"
        },
        {
          "name": "blank conversationId",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"\", \"activityId\": \"a-1\"}"
        },
        {
          "name": "non-string activityId",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": 7}"
        },
        {
          "name": "future schemaVersion is incompatible",
          "body": "{\"tenantId\": \"t-1\", \"conversationId\": \"c-1\", \"activityId\": \"a-1\", \"schemaVersion\": 2}"
        }
      ]
    },
    "buildReply": [
      {
        "name": "reply kind=message",
        "kind": "message",
        "expected": {
          "schemaVersion": 1,
          "tenantId": "t-1",
          "conversationId": "c-1",
          "replyToId": "a-1",
          "kind": "message",
          "idempotencyKey": "a-1:message",
          "text": "the answer"
        }
      },
      {
        "name": "reply kind=typing",
        "kind": "typing",
        "expected": {
          "schemaVersion": 1,
          "tenantId": "t-1",
          "conversationId": "c-1",
          "replyToId": "a-1",
          "kind": "typing",
          "idempotencyKey": "a-1:typing"
        }
      },
      {
        "name": "reply kind=error",
        "kind": "error",
        "expected": {
          "schemaVersion": 1,
          "tenantId": "t-1",
          "conversationId": "c-1",
          "replyToId": "a-1",
          "kind": "error",
          "idempotencyKey": "a-1:error",
          "text": "the answer"
        }
      }
    ]
  },
  "video": {
    "$comment": "The vision lane. parseVideoFrame is deliberately lenient: an unusable frame is DROPPED, never raised, because one malformed image must not end a live call.",
    "parseAccepts": [
      {
        "name": "a full screen-share frame",
        "input": {
          "type": "video.frame",
          "source": "screenshare",
          "ts": 1738000000000,
          "width": 1280,
          "height": 720,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "participantId": "aad-1",
          "participantName": "Dana"
        },
        "expected": {
          "source": "screenshare",
          "ts": 1738000000000,
          "width": 1280,
          "height": 720,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "participantId": "aad-1",
          "participantName": "Dana"
        }
      },
      {
        "name": "a camera frame with no identity and no mime",
        "input": {
          "source": "camera",
          "ts": 7,
          "width": 320,
          "height": 240,
          "dataBase64": "/9j/4AAQ"
        },
        "expected": {
          "source": "camera",
          "ts": 7,
          "width": 320,
          "height": 240,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "participantId": null,
          "participantName": null
        }
      },
      {
        "name": "blank identity fields read as absent",
        "input": {
          "source": "camera",
          "ts": 0,
          "width": 2,
          "height": 2,
          "dataBase64": "/9j/4AAQ",
          "participantId": "   ",
          "participantName": ""
        },
        "expected": {
          "source": "camera",
          "ts": 0,
          "width": 2,
          "height": 2,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "participantId": null,
          "participantName": null
        }
      },
      {
        "name": "a malformed timestamp becomes zero rather than dropping the frame",
        "input": {
          "source": "camera",
          "ts": -5,
          "width": 2,
          "height": 2,
          "dataBase64": "/9j/4AAQ"
        },
        "expected": {
          "source": "camera",
          "ts": 0,
          "width": 2,
          "height": 2,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "participantId": null,
          "participantName": null
        }
      }
    ],
    "parseRejects": [
      {
        "name": "unknown source",
        "input": {
          "source": "whiteboard",
          "width": 2,
          "height": 2,
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "missing source",
        "input": {
          "width": 2,
          "height": 2,
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "empty payload",
        "input": {
          "source": "camera",
          "width": 2,
          "height": 2,
          "dataBase64": ""
        }
      },
      {
        "name": "missing payload",
        "input": {
          "source": "camera",
          "width": 2,
          "height": 2
        }
      },
      {
        "name": "payload is not base64",
        "input": {
          "source": "camera",
          "width": 2,
          "height": 2,
          "dataBase64": "not base64!"
        }
      },
      {
        "name": "payload has non-canonical padding",
        "input": {
          "source": "camera",
          "width": 2,
          "height": 2,
          "dataBase64": "/9j/4A"
        }
      },
      {
        "name": "zero width",
        "input": {
          "source": "camera",
          "width": 0,
          "height": 2,
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "negative height",
        "input": {
          "source": "camera",
          "width": 2,
          "height": -1,
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "missing dimensions",
        "input": {
          "source": "camera",
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "fractional width",
        "input": {
          "source": "camera",
          "width": 2.5,
          "height": 2,
          "dataBase64": "/9j/4AAQ"
        }
      }
    ],
    "displayImage": [
      {
        "name": "defaults carry the reserved timeline anchor",
        "dataBase64": "/9j/4AAQ",
        "expected": {
          "type": "display.image",
          "dataBase64": "/9j/4AAQ",
          "mime": "image/jpeg",
          "ts": 0
        }
      },
      {
        "name": "every option",
        "dataBase64": "/9j/4AAQ",
        "mime": "image/png",
        "durationMs": 4000,
        "mode": "overlay",
        "caption": "Q3 revenue",
        "expected": {
          "type": "display.image",
          "dataBase64": "/9j/4AAQ",
          "mime": "image/png",
          "ts": 0,
          "durationMs": 4000,
          "mode": "overlay",
          "caption": "Q3 revenue"
        }
      },
      {
        "name": "a non-positive duration falls back to the service default",
        "dataBase64": "/9j/4AAQ",
        "durationMs": 0,
        "expected": {
          "type": "display.image",
          "dataBase64": "/9j/4AAQ",
          "mime": "image/jpeg",
          "ts": 0
        }
      }
    ],
    "displayFrame": [
      {
        "name": "the minimum a stream frame carries",
        "seq": 1,
        "ts": 20,
        "dataBase64": "/9j/4AAQ",
        "expected": {
          "type": "display.frame",
          "seq": 1,
          "ts": 20,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ"
        }
      },
      {
        "name": "informational dimensions are passed through",
        "seq": 2,
        "ts": 40,
        "dataBase64": "/9j/4AAQ",
        "width": 640,
        "height": 360,
        "expected": {
          "type": "display.frame",
          "seq": 2,
          "ts": 40,
          "mime": "image/jpeg",
          "dataBase64": "/9j/4AAQ",
          "width": 640,
          "height": 360
        }
      }
    ]
  },
  "avatar": {
    "$comment": "The avatar lane. Both messages are additive and best-effort: they change the bot's video tile and never a sample of the audio, so neither can fail a call.",
    "expression": [
      {
        "name": "a well-known emotion",
        "input": "happy",
        "expected": {
          "type": "expression",
          "emotion": "happy"
        }
      },
      {
        "name": "an unknown emotion is sent as-is and renders neutral",
        "input": "wistful",
        "expected": {
          "type": "expression",
          "emotion": "wistful"
        }
      },
      {
        "name": "surrounding space is trimmed",
        "input": "  sad  ",
        "expected": {
          "type": "expression",
          "emotion": "sad"
        }
      }
    ],
    "expressionRejects": [
      {
        "name": "empty",
        "input": ""
      },
      {
        "name": "only whitespace",
        "input": "   "
      },
      {
        "name": "an emotion longer than the bound",
        "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      }
    ],
    "speechMarks": [
      {
        "name": "marks are sorted onto the utterance timeline",
        "input": [
          {
            "tMs": 40,
            "visemeId": 3
          },
          {
            "tMs": 0,
            "visemeId": 1
          }
        ],
        "expected": {
          "type": "speech.marks",
          "ts": 0,
          "marks": [
            {
              "tMs": 0,
              "visemeId": 1
            },
            {
              "tMs": 40,
              "visemeId": 3
            }
          ]
        }
      },
      {
        "name": "a viseme outside the Azure numbering is dropped, not sent",
        "input": [
          {
            "tMs": 0,
            "visemeId": 1
          },
          {
            "tMs": 20,
            "visemeId": 99
          },
          {
            "tMs": 30,
            "visemeId": -1
          }
        ],
        "expected": {
          "type": "speech.marks",
          "ts": 0,
          "marks": [
            {
              "tMs": 0,
              "visemeId": 1
            }
          ]
        }
      },
      {
        "name": "a negative offset is dropped",
        "input": [
          {
            "tMs": -5,
            "visemeId": 2
          },
          {
            "tMs": 10,
            "visemeId": 21
          }
        ],
        "expected": {
          "type": "speech.marks",
          "ts": 0,
          "marks": [
            {
              "tMs": 10,
              "visemeId": 21
            }
          ]
        }
      },
      {
        "name": "an empty timeline is still a valid message",
        "input": [],
        "expected": {
          "type": "speech.marks",
          "ts": 0,
          "marks": []
        }
      }
    ]
  }
}
